{
  "name": "patana",
  "version": "1.0.0",
  "private": true,
  "description": "Patana - Verified marketplace directory connecting buyers and sellers via WhatsApp",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter api build && pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "db:generate": "pnpm --filter api prisma generate",
    "db:push": "pnpm --filter api prisma db push",
    "db:migrate": "pnpm --filter api prisma migrate dev",
    "db:studio": "pnpm --filter api prisma studio",
    "lint": "pnpm -r lint"
  },
  "keywords": ["marketplace", "uganda", "whatsapp", "patana"],
  "author": "Shafic Kiryowa",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@8.15.9"
}
